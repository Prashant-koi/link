# ---- Postgres (connection graph: actor/context/concept/edge) --------------
# See db/migrations. Requires the pgvector extension.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/link

# ---- Graph database -------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=studentos
NEO4J_DATABASE=neo4j

# ---- Auth (see auth and login handoff) -------------------------------------
# demo: passwords derived from names, per db/migrations/0006. Refuses to boot
# in production, and refuses to boot at all without ALLOW_DEMO_AUTH=1 — see
# checkAuthModeGate in src/auth/modeGate.ts. real mode is stubbed only.
AUTH_MODE=demo
ALLOW_DEMO_AUTH=1
NODE_ENV=development
# Signs the session cookie. Any long random string; rotate before anything
# resembling production (rotating invalidates every existing session).
SESSION_SECRET=dev-only-change-me-to-a-long-random-string
# Cost 8 in demo mode only — the plaintext is derivable from the username by
# design, so the hash isn't protecting anything yet. Real mode must raise
# this to 12 and switch to argon2id.
AUTH_BCRYPT_COST=8

# ---- LLM (OpenAI-compatible endpoint; vLLM or Ollama on the GX10) ----------
# While the GPU host is unavailable, leave LLM_BASE_URL empty: jobs that need
# the model runtime (resolve_concept past the fuzzy/vector stage, embed,
# extract_bio, explain_pair, parse_ask) fail cleanly with a clear error
# instead of hanging or corrupting data. Point this at vLLM/Ollama and
# nothing else changes.
#   vllm serve Qwen/Qwen2.5-14B-Instruct --enable-auto-tool-choice \
#     --tool-call-parser hermes --port 8000
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
LLM_EMBEDDING_MODEL=
LLM_API_KEY=not-needed-for-local-vllm

# ---- Backend services (see backend services handoff) -----------------------
API_PORT=3001
# Instruct concurrency stays low deliberately - one GPU, thrashed KV cache
# otherwise. Embedding concurrency/batch size can be much higher.
INSTRUCT_CONCURRENCY=2
EMBEDDING_CONCURRENCY=8
EMBEDDING_BATCH_SIZE=256
WORKER_POLL_INTERVAL_MS=1000
# Resolution pipeline thresholds - placeholders pending measurement, per the
# data model handoff's own open questions.
RESOLUTION_ACCEPT_THRESHOLD=0.92
RESOLUTION_ADJUDICATE_FLOOR=0.75
