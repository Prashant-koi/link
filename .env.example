# ---- Graph database -------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=studentos
NEO4J_DATABASE=neo4j

# ---- Auth -----------------------------------------------------------------
# Any long random string. Rotate before anything resembling production.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_TTL=12h

# ---- LLM (OpenAI-compatible endpoint; vLLM on the GPU box) -----------------
# While the GPU host is unavailable, leave LLM_BASE_URL empty: the agent loop
# falls back to a deterministic local planner that still calls the real,
# RBAC-scoped graph tools. Point this at vLLM and nothing else changes.
#   vllm serve Qwen/Qwen2.5-14B-Instruct --enable-auto-tool-choice \
#     --tool-call-parser hermes --port 8000
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
LLM_API_KEY=not-needed-for-local-vllm
