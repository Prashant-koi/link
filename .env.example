# ---- Postgres (connection graph: actor/context/concept/edge) --------------
# See db/migrations. Requires the pgvector extension.
POSTGRES_PASSWORD=change-me-generate-a-real-value
DATABASE_URL=postgres://link:change-me-generate-a-real-value@postgres:5432/link
# For local (non-docker) dev against a plain postgres on this machine:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/link

# ---- Model runtime (deployment handoff settled this: Ollama, not vLLM —
# aarch64 + CUDA 13 on the GX10 has no stable vLLM release) -----------------
# host.docker.internal, not localhost: inside a container, localhost is the
# container itself, and the worker will report connection refused while
# Ollama is demonstrably running. From the host machine directly (or when
# LLM_BASE_URL is empty below), this doesn't matter.
# On the GX10 Ollama runs natively on 127.0.0.1 and the worker uses host networking
# (docker-compose.yml overrides this for the worker). Only the worker/seeder use it.
LLM_BASE_URL=http://127.0.0.1:11434
# nomic-embed-text is 768 dimensions, matching concept.embedding vector(768)
# exactly. Swapping embedding models means a migration + full re-embed, not
# a config change — see the deployment handoff, "Models".
LLM_EMBED_MODEL=nomic-embed-text
LLM_INSTRUCT_MODEL=qwen2.5:14b-instruct
LLM_API_KEY=
# Thinking models (qwen3.x, nemotron) burn the whole token budget reasoning and
# return empty JSON; "none" switches that off on Ollama. Blank = don't send it.
LLM_REASONING_EFFORT=none
# nomic-embed-text task prefixes. Blank both for an embedder that has none.
LLM_EMBED_QUERY_PREFIX=search_query: 
LLM_EMBED_DOCUMENT_PREFIX=search_document: 
# Ollama serialises per model regardless, so raising this past 1-2 only adds
# queueing latency you can't see.
LLM_INSTRUCT_CONCURRENCY=2
EMBEDDING_CONCURRENCY=8
LLM_EMBED_BATCH=256
WORKER_POLL_INTERVAL_MS=1000
# Resolution pipeline thresholds. The adjudication floor was measured (nomic-embed-text,
# 324 labelled messy strings): 0.75 sent ~72% of unresolved strings to "propose a new
# concept"; 0.60 sends ~80% to model adjudication instead. Accept stays high — few
# strings reach it, and it must be safe.
RESOLUTION_ACCEPT_THRESHOLD=0.92
RESOLUTION_ADJUDICATE_FLOOR=0.60
# See seed data handoff, stage 7 — leave unset (graceful needs_review) unless
# there's a runtime to point at and an unreachable model should hard-fail.
RESOLUTION_STRICT=

# ---- Auth (see auth and login handoff) -------------------------------------
# demo: passwords derived from names, per db/migrations/0007_auth. Refuses to
# boot in production, and refuses to boot at all without ALLOW_DEMO_AUTH=1 —
# see checkAuthModeGate in src/auth/modeGate.ts. real mode is stubbed only.
AUTH_MODE=demo
ALLOW_DEMO_AUTH=1
# Stays "development" even behind the tunnel — deployment handoff, "Environment":
# the mode gate refusing demo+production is correct and deliberate. The
# tradeoff is the session cookie's Secure flag stays off, which is fine only
# because the tunnel terminates TLS in front of it.
NODE_ENV=development
# Must be a real generated value (32+ bytes) once this is reachable from
# outside this machine — a default checked into the repo means anyone can
# forge a session cookie for any user on the tunnel URL.
SESSION_SECRET=dev-only-change-me-to-a-long-random-string
# Cost 8 in demo mode only — the plaintext is derivable from the username by
# design, so the hash isn't protecting anything yet. Real mode must raise
# this to 12 and switch to argon2id.
AUTH_BCRYPT_COST=8

# ---- Imports (resume / LinkedIn / GitHub / courses) ------------------------
# Optional. Unauthenticated GitHub API calls are capped at 60/hour per IP,
# which a demo can burn through; a classic read-only token raises that to
# 5000/hour. Nothing else changes when it is unset.
GITHUB_TOKEN=

# ---- App server -------------------------------------------------------------
API_PORT=3000

# ---- Seeding ----------------------------------------------------------------
# Fallback default for `npm run seed` when --seed isn't passed on the CLI.
SEED=42

# ---- HTTPS (nginx + Let's Encrypt, see nginx/user_conf.d/) ------------------
# Account email Let's Encrypt uses for expiry notices. The domain itself is in
# nginx/user_conf.d/linkmit.conf, not here — nginx can't read env vars.
CERTBOT_EMAIL=you@example.com
# Leave unset/0 for a real Let's Encrypt certificate. Set to 1 only as a
# stopgap (self-signed, browsers warn) until linkmit.duckdns.org resolves to
# this machine's PUBLIC IP and ports 80 and 443 are forwarded to it — then
# remove it and recreate the cert: docker compose down nginx &&
# docker volume rm link_nginx_secrets && docker compose up -d nginx
USE_LOCAL_CA=0
