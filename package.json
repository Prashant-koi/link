{
  "name": "link-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/run-api.ts",
    "dev:ingest-worker": "tsx watch src/run-ingest-worker.ts",
    "dev:resolution-worker": "tsx watch src/run-resolution-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/run-api.js",
    "start:worker": "node dist/run-resolution-worker.js",
    "start:ingest-worker": "node dist/run-ingest-worker.js",
    "start:resolution-worker": "node dist/run-resolution-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:seed": "tsx src/seed/index.ts",
    "dev:migrate": "tsx src/migrate.ts",
    "seed": "node dist/seed/index.js",
    "migrate": "node dist/migrate.js",
    "reprocess": "node dist/scripts/reprocess.js",
    "dev:reprocess": "tsx src/scripts/reprocess.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "pg": "^8.12.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
