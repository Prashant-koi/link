{
  "name": "studentos",
  "version": "0.1.0",
  "private": true,
  "description": "A university modeled as a connected knowledge graph, rendered as a desktop shell, made perspectival by RBAC and navigable by a self-hosted LLM.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d neo4j",
    "db:down": "docker compose down",
    "seed": "tsx seed/seed.ts",
    "test": "vitest run",
    "test:rbac": "vitest run tests/rbac.test.ts"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "neo4j-driver": "^5.28.1",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.27.1",
    "react-rnd": "^10.5.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.17",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "dotenv": "^16.4.7",
    "tailwindcss": "^4.0.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
